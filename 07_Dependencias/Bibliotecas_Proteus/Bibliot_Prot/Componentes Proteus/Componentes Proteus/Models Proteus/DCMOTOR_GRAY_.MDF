U1,NOR_2,NOR_2,INVERT=D0,PRIMITIVE=DIGITAL,TDHLDQ=1n,TDLHDQ=1n,TGQ=500p
U2,NOR_2,NOR_2,INVERT=D1,PRIMITIVE=DIGITAL,TDHLDQ=1n,TDLHDQ=1n,TGQ=500p
U3,NOR_2,NOR_2,PRIMITIVE=DIGITAL,TDHLDQ=1n,TDLHDQ=1n,TGQ=500p
U4,NOR_2,NOR_2,PRIMITIVE=DIGITAL,TDHLDQ=1n,TDLHDQ=1n,TGQ=500p

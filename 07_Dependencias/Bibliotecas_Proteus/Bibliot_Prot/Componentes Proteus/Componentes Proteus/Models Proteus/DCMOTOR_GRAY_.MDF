*PROPERTIES,3    
OMEGA=(2*<PI>*<RPM>/60)
PI=3.141592
RPV=(<OMEGA>/<VNOM>)

*MODELDEFS,0    

*PARTLIST,20   
AD1,ADC,ADC,DCPATH="G",PRIMITIVE=ANALOG,RNEG=1,RPOS=100k,TTOL=0.1u,V+=VCC,V-=GND,VHH=1,VHL=1,VTH=0.2,VTL=-0.2
